@using BankingSimulation.Blazor.Models.Calendars

<table class="table table-striped" aria-labelledby="tableLabel">
    <thead>
    <tr>
        <th>Name</th>
        <th>Start</th>
        <th>End</th>
        <th style="text-align:right;">Actions</th>
    </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.Name</td>
                <td>@entry.Start</td>
                <td>@entry.End</td>
                <td style="text-align:right;">
                    <button 
                        class="btn btn-danger" 
                        @onclick="() => OnDeleteEventAsync(entry.Name, entry.Start, entry.End)"
                    >Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code
{
    [Parameter]
    public IList<EditCalendarEventViewModel> Model { get; set; } = [];

    [Parameter]
    public EventCallback<IList<EditCalendarEventViewModel>> ModelChanged { get; set; }

    private async Task OnDeleteEventAsync(string? name, DateOnly start, DateOnly end)
    {
        var newList = Model.First(m => m.Name == name && m.Start == start && m.End == end);
        Model.Remove(newList);
        StateHasChanged();
        await ModelChanged.InvokeAsync(Model);
    }
}