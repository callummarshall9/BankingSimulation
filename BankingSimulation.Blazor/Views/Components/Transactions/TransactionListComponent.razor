@using BankingSimulation.Blazor.Models.Transactions
@using BankingSimulation.Blazor.ViewServices.Transactions
<h1 id="tableLabel">Transactions</h1>
<table class="table table-striped" aria-labelledby="tableLabel">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Account Number</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var entry in Model.Transactions)
        {
            <tr>
                <td>@entry.Date</td>
                <td>@entry.Description</td>
                <td>@entry.AccountNumber</td>
                <td>@entry.Value</td>
            </tr>
        }

        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td>@Math.Round(Model.Summation, 2)</td>
        </tr>
    </tbody>
</table>

@code
{
    [Inject]
    public ITotalTransactionViewService TransactionViewService { get; set; } = null!;

    public TotalTransactionsViewModel Model { get; set; } = new TotalTransactionsViewModel();

    protected override void OnInitialized()
    {
        Model = TransactionViewService.GetTransactions();
    }
}