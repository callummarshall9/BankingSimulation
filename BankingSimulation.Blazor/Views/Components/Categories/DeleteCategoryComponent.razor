@using BankingSimulation.Blazor.ViewServices.Categories
@if (Deleting)
{
    <p>Deleting</p>
}
else
{
    <button class="btn btn-danger" @onclick=OnDelete>Delete</button>
}

@code
{
    [Parameter]
    public Guid CategoryId { get; set; }

    public bool Deleting { get; set; }

    [Parameter]
    public EventCallback<Guid> OnCategoryDelete { get; set; }

    [Inject]
    public ICategoryViewService CategoryViewService { get; set; } = null!;

    async Task OnDelete()
    {
        Deleting = true;
        await CategoryViewService.DeleteCategoryAsync(CategoryId);

        Deleting = false;
        await OnCategoryDelete.InvokeAsync(CategoryId);
    }
}
