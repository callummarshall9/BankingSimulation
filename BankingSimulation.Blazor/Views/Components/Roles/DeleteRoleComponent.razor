@using BankingSimulation.Blazor.ViewServices.Roles
@if (Deleting)
{
    <p>Deleting</p>
}
else
{
    <button class="btn btn-danger" @onclick=OnDelete>Delete</button>
}

@code
{
    [Parameter]
    public Guid RoleId { get; set; }

    public bool Deleting { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRoleDelete { get; set; }

    [Inject]
    public IRoleViewService RoleViewService { get; set; } = null!;

    async Task OnDelete()
    {
        Deleting = true;
        await RoleViewService.DeleteRoleAsync(RoleId);

        Deleting = false;
        await OnRoleDelete.InvokeAsync(RoleId);
    }
}
